# Copiar para .env.local (desenvolvimento) e preencher no painel da Vercel
# (Project → Settings → Environment Variables). Nunca commitar valores.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Chave publishable (sb_publishable_…). Também aceita o nome antigo NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Único email autorizado a entrar
ALLOWED_EMAIL=
# Chave do link pessoal de acesso (/entrar?chave=...). Longa e aleatória (mín. 20 caracteres).
ACCESS_KEY=

# Anthropic (treinador IA). Por omissão: claude-opus-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Google Gemini (fotos e texto das refeições). Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
# gemini (por omissão) ou anthropic
FOOD_AI_PROVIDER=

# Intervals.icu (Settings → Developer Settings)
INTERVALS_ATHLETE_ID=
INTERVALS_API_KEY=

# Segredo para as rotas de cron (gera com: openssl rand -hex 32)
CRON_SECRET=

APP_TIMEZONE=Europe/Lisbon

# Token do Atalho do iPhone que envia o peso da app Saúde (POST /api/ingest/weight).
# Longo e aleatório (mín. 20 caracteres); diferente das outras chaves.
WEIGHT_INGEST_TOKEN=
